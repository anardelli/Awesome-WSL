/// zenohd_config.json5
/// ====================
/// Zenohd router configuration for receiving and routing raw Asterix frames.
///
/// Usage:
///   zenohd --config zenohd_config.json5
///
/// Reference: https://zenoh.io/docs/manual/configuration/

{
  /// --------------------------------------------------------------------
  /// Router identity (optional – auto-generated if omitted)
  /// --------------------------------------------------------------------
  // id: "asterix-router-01",

  /// --------------------------------------------------------------------
  /// Endpoints zenohd will listen on.
  /// The bridge and subscribers connect here.
  /// --------------------------------------------------------------------
  listen: {
    endpoints: [
      "tcp/0.0.0.0:7447",   // TCP – default Zenoh port
      "udp/0.0.0.0:7447",   // UDP transport (optional)
    ],
  },

  /// --------------------------------------------------------------------
  /// Routing: connect to other zenohd routers if needed
  /// (leave empty for a standalone router)
  /// --------------------------------------------------------------------
  connect: {
    endpoints: [],
  },

  /// --------------------------------------------------------------------
  /// Shared-memory transport
  /// Enabled for high-throughput radar feeds when bridge and router
  /// run on the same host (WSL2 or native Linux).
  /// --------------------------------------------------------------------
  transport: {
    unicast: {
      lowlatency: false,
      qos: {
        enabled: true,
      },
    },
    shared_memory: {
      enabled: true,
    },
  },

  /// --------------------------------------------------------------------
  /// Buffer / queue sizes
  /// Increase for bursty ATC radar feeds (values in bytes).
  /// --------------------------------------------------------------------
  // transport: {
  //   unicast: {
  //     receiver_buffer_size: 1048576,   // 1 MB
  //     sender_buffer_size:   1048576,
  //   },
  // },

  /// --------------------------------------------------------------------
  /// Scouting: enable automatic peer/router discovery on the LAN
  /// --------------------------------------------------------------------
  scouting: {
    multicast: {
      enabled: true,
      address: "224.0.0.224:7446",
      interface: "auto",
      autoconnect: {
        router: "router",
        peer: "router|peer",
      },
      listen: true,
    },
    gossip: {
      enabled: true,
      multihop: false,
      autoconnect: {
        router: "router",
        peer: "router|peer",
      },
    },
  },

  /// --------------------------------------------------------------------
  /// Logging level (trace | debug | info | warn | error)
  /// --------------------------------------------------------------------
  // log: {
  //   level: "info",
  // },
}
